# KÔMA tablet reference model
# Base mesh inspired by the supplied 1000x1000 SVG reference.
# Units: metres. Approximate proportions: 0.68m wide x 1.00m tall x 0.065m deep.
# The screen is a separate named object/material so KÔMA UI artwork can replace it.
mtllib koma-tablet-reference.mtl

o koma_tablet_body
g koma_tablet_body
usemtl koma_body

# Outer front perimeter, clockwise when viewed from the front (-Y)
v -0.280 -0.0325 0.500
v  0.280 -0.0325 0.500
v  0.303 -0.0325 0.495
v  0.322 -0.0325 0.482
v  0.336 -0.0325 0.463
v  0.340 -0.0325 0.440
v  0.340 -0.0325 -0.440
v  0.336 -0.0325 -0.463
v  0.322 -0.0325 -0.482
v  0.303 -0.0325 -0.495
v  0.280 -0.0325 -0.500
v -0.280 -0.0325 -0.500
v -0.303 -0.0325 -0.495
v -0.322 -0.0325 -0.482
v -0.336 -0.0325 -0.463
v -0.340 -0.0325 -0.440
v -0.340 -0.0325 0.440
v -0.336 -0.0325 0.463
v -0.322 -0.0325 0.482
v -0.303 -0.0325 0.495

