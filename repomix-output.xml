    background_tasks.add_task(manager.broadcast, {
        "event": "tables_updated",
        "detail": {
            "type": "desmesclar_mesa",
            "comanda_id": comanda_id,
            "mesa_origem": mesa_origem
        }
    })
    
    return comanda
