          if (data.event === "customers_updated") {
            window.dispatchEvent(new Event('koma_customers_updated'));
          }
          if (data.event === "tables_updated" || data.event === "TABLE_UPDATED") {
            if (wsUpdateTimeout) {
              clearTimeout(wsUpdateTimeout);
            }
            wsUpdateTimeout = setTimeout(() => {
              fetchOrdersFromAPI();
              fetchTables();
              fetchLiveProdutos();
