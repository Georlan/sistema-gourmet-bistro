    };

    document.addEventListener("visibilitychange", handleVisibilityChange);
    connectWS();

    return () => {
      document.removeEventListener("visibilitychange", handleVisibilityChange);
      clearTimeout(reconnectTimeout);
      clearTimeout(wsUpdateTimeout);
      if (ws) {
        ws.onopen = null;
        ws.onmessage = null;
        ws.onclose = null;
        ws.onerror = null;
        ws.close();
      }
