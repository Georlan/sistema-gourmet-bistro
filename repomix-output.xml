    def test_fase1_2_database_constraints(self):
        """Fase 1 & 2: Verifica integridade de chaves estrangeiras e relacionamentos"""
        # 1. Inserir Garçom
        g = Garcom(id="g-test", nome="Test Waiter", usuario="waiter1", senha_hash="xyz")
        self.db.add(g)
        self.db.commit()
        
        # 2. Inserir Categoria
