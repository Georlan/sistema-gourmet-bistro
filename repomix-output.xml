            role="garcom", cargo="garcom", status="ativo"
        ))
        # Gerente ativo
        db.add(Usuario(
            id="u-gerente", restaurante_id=1, nome="Gerente Auth",
            usuario="gerente", senha_hash=get_password_hash("123"),
            role="gerente", cargo="gerente", status="ativo"
