        text = '{"messages":[{"id":"wmid.123"}]}'
        def json(self):
            return {"messages": [{"id": "wmid.123"}]}

    def mock_post(self, url, headers=None, json=None, **kwargs):
        nonlocal posted_payload
        posted_payload = json
        return MockResponse()

    monkeypatch.setattr(httpx.Client, "post", mock_post)

