                response = await client.request(
                    "DELETE",
                    delete_url,
                    headers=_supabase_storage_headers(),
                    json={"prefixes": [object_path]},
                )
        except httpx.HTTPError as exc:
            logger.warning(
                "Falha de rede ao remover %s do restaurante %s: %s",
