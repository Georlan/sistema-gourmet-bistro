# Copie para .env e gere valores diferentes para cada placeholder.
# Nunca versione o arquivo .env real.

SERVER_NAME=koma-evolution
SERVER_TYPE=http
SERVER_PORT=8080
SERVER_URL=http://localhost:8080

CORS_ORIGIN=http://localhost:5173
CORS_METHODS=GET,POST,PUT,DELETE
CORS_CREDENTIALS=true
LOG_LEVEL=ERROR,WARN,INFO
DEL_INSTANCE=false

POSTGRES_DATABASE=evolution
POSTGRES_USERNAME=evolution
POSTGRES_PASSWORD=SUBSTITUA_POR_UMA_SENHA_ALEATORIA
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:SUBSTITUA_POR_UMA_SENHA_ALEATORIA@evolution-postgres:5432/evolution?schema=evolution_api
DATABASE_CONNECTION_CLIENT_NAME=koma_evolution

# O piloto só envia OTP e notificações. Não retenha contatos, chats ou mensagens.
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=false
DATABASE_SAVE_MESSAGE_UPDATE=false
DATABASE_SAVE_DATA_CONTACTS=false
DATABASE_SAVE_DATA_CHATS=false
DATABASE_SAVE_DATA_LABELS=false
DATABASE_SAVE_DATA_HISTORIC=false
DATABASE_SAVE_IS_ON_WHATSAPP=false
DATABASE_DELETE_MESSAGE=true

CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://evolution-redis:6379/6
CACHE_REDIS_TTL=604800
CACHE_REDIS_PREFIX_KEY=koma
CACHE_REDIS_SAVE_INSTANCES=false

CONFIG_SESSION_PHONE_CLIENT=Koma
CONFIG_SESSION_PHONE_NAME=Chrome
QRCODE_LIMIT=30

AUTHENTICATION_API_KEY=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=false
