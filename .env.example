# ─────────────────────────────────────────────────────────────
# KÔMA — Variáveis de Ambiente (Exemplo com Placeholders)
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA suba o .env para o git (já está no .gitignore).
# ─────────────────────────────────────────────────────────────

# ── BANCO DE DADOS ─────────────────────────────────────────────
# Desenvolvimento local: usa SQLite (sem configuração de senha)
DATABASE_URL="sqlite:///./bistro.db"

# Produção (Supabase/PostgreSQL RLS):
# DATABASE_URL="postgresql://usuario_app:SUA_SENHA@db.host.supabase.co:6543/postgres"
# MIGRATION_DATABASE_URL="postgresql://usuario_admin:SUA_SENHA@db.host.supabase.co:5432/postgres"

DB_POOL_SIZE="5"
DB_MAX_OVERFLOW="5"
DB_POOL_TIMEOUT="15"
DB_POOL_RECYCLE="1800"
MIGRATION_LOCK_TIMEOUT_MS="15000"
MIGRATION_STATEMENT_TIMEOUT_MS="600000"
CREATE_SCHEMA_ON_STARTUP="false"

# ── SEGURANÇA / JWT ────────────────────────────────────────────
SECRET_KEY="SUBSTITUA_POR_SUA_CHAVE_SECRET_KEY_ALEATORIA"
ENCRYPTION_KEY="SUBSTITUA_POR_SUA_CHAVE_FERNET_ENCRYPTION_KEY"

# ── IDENTIDADE JURÍDICA DO PRESTADOR ──────────────────────────
KOMA_LEGAL_PROVIDER_NAME="NOME_DO_PRESTADOR"
KOMA_LEGAL_PROVIDER_TAX_ID="CPF_VALIDO_DO_PRESTADOR"
KOMA_LEGAL_PROVIDER_ADDRESS="ENDERECO_JURIDICO_COMPLETO_DO_PRESTADOR"
KOMA_LEGAL_PROVIDER_LOCATION="Limoeiro do Norte/CE"

# ── SEGURANÇA CORS (CONFIGURAÇÃO POR AMBIENTE) ────────────────
CORS_ALLOWED_ORIGINS="https://sistema-gourmet-bistro.pages.dev"
CORS_ALLOW_CREDENTIALS="false"
WEBSOCKET_ALLOW_MISSING_ORIGIN="false"

CUSTOMER_TOKEN_EXPIRE_MINUTES="43200"
CUSTOMER_OTP_TTL_SECONDS="300"
CUSTOMER_OTP_RESEND_SECONDS="60"
CUSTOMER_OTP_WINDOW_SECONDS="900"
CUSTOMER_OTP_MAX_SENDS="5"
CUSTOMER_OTP_MAX_ATTEMPTS="5"
CUSTOMER_OTP_MAX_IP_REQUESTS="20"

# ── SEED LOCAL DESTRUTIVO ─────────────────────────────────────
KOMA_ALLOW_DESTRUCTIVE_SEED=""
KOMA_SEED_ADMIN_PASSWORD=""

# ── SUPERADMIN ─────────────────────────────────────────────────
SUPERADMIN_USERNAME="admin"
SUPERADMIN_PASSWORD_HASH="SUBSTITUA_PELO_HASH_BCRYPT_DA_SUA_SENHA"

# ── SENTRY (MONITORAMENTO) ─────────────────────────────────────
SENTRY_DSN=""
SENTRY_SEND_PII="False"

# ── SERVIÇOS EXTERNOS (SUPERADMIN / DEVOPS) ────────────────────
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ZONE_ID=""
RAILWAY_API_TOKEN=""
RAILWAY_PROJECT_ID=""
RAILWAY_ENVIRONMENT_ID=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
GITHUB_TOKEN=""

# ── IMPRESSORA TÉRMICA ─────────────────────────────────────────
KOMA_TIMEZONE="America/Fortaleza"
SIMULATE_PRINTER="True"
PRINTER_NAME="Generic / Text Only"
PRINTER_WIDTH="40"
PRINT_JOBS_DIR="./print_jobs"

# ── SMARTPOS ───────────────────────────────────────────────────
KOMA_SMARTPOS_PROVIDER="disabled"

# ── HOMOLOGAÇÃO DE PLANOS ─────────────────────────────────────
KOMA_TEST_PREMIUM_RESTAURANTE_IDS="1,2"

# ── AUTOMAÇÃO WHATSAPP ──────────────────────────────────────
KOMA_WHATSAPP_AUTOMATION_ENABLED="false"
KOMA_WHATSAPP_PROVIDER="evolution"
KOMA_PUBLIC_APP_URL="https://sistema-gourmet-bistro.pages.dev"

# ── META CLOUD API (OPCIONAL / RESERVADO PARA USO FUTURO) ────
META_VERIFY_TOKEN=""
META_APP_SECRET=""
META_PHONE_NUMBER_ID=""
META_ACCESS_TOKEN=""
META_USE_TEMPLATE="False"
META_OTP_TEMPLATE_NAME="koma_otp"

# ── EVOLUTION API ───────────────────────────────────────────
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE_NAME="koma-piloto"
EVOLUTION_API_ORIGIN="https://sistema-gourmet-bistro.pages.dev"
EVOLUTION_REQUEST_TIMEOUT_SECONDS="10"

# ── FRONTEND CONFIG ────────────────────────────────────────────
VITE_API_URL="http://localhost:8000"
VITE_WS_URL="ws://localhost:8000"
VITE_SENTRY_DSN=""
VITE_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_SUA_CHAVE_PUBLICA"

# ── PAGAMENTO ONLINE / SPLIT ─────────────────────────────────
KOMA_PUBLIC_API_URL="https://sistema-gourmet-bistro-production.up.railway.app"
MERCADO_PAGO_CLIENT_ID=""
MERCADO_PAGO_CLIENT_SECRET=""
MERCADO_PAGO_WEBHOOK_SECRET=""
MERCADO_PAGO_OAUTH_REDIRECT_URI="https://sistema-gourmet-bistro-production.up.railway.app/payments/mercado-pago/oauth/callback"
MERCADO_PAGO_OAUTH_STATE_TTL_SECONDS="600"
MERCADO_PAGO_OAUTH_TEST_TOKEN="false"
ONLINE_PAYMENT_PLAN_FEES_ENABLED="false"
ONLINE_PAYMENT_PIX_EXPIRATION_MINUTES=30
ONLINE_PAYMENT_REQUEST_TIMEOUT_SECONDS=12

# Password recovery: enable only after verifying the sender domain in Resend.
PASSWORD_RECOVERY_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=

# ── WEB PUSH / PWA DO CARDÁPIO ────────────────────────────────
# Habilite somente depois de gerar e configurar o par VAPID no backend.
# A private key é segredo de Railway/backend: nunca use prefixo VITE_.
WEB_PUSH_ENABLED="false"
WEB_PUSH_VAPID_PUBLIC_KEY=""
WEB_PUSH_VAPID_PRIVATE_KEY=""
WEB_PUSH_VAPID_SUBJECT="mailto:SEU_EMAIL_OPERACIONAL"
WEB_PUSH_TTL_SECONDS="3600"
