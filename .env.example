# ─────────────────────────────────────────────────────────────
# KÔMA — Variáveis de Ambiente (Exemplo com Placeholders)
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA suba o .env para o git (já está no .gitignore).
# ─────────────────────────────────────────────────────────────

# ── BANCO DE DADOS ─────────────────────────────────────────────
# Desenvolvimento local: usa SQLite (sem configuração de senha)
DATABASE_URL="sqlite:///./bistro.db"

# Produção (Supabase/PostgreSQL RLS):
# DATABASE_URL="postgresql://usuario_app:SUA_SENHA@db.host.supabase.co:6543/postgres"
# MIGRATION_DATABASE_URL="postgresql://usuario_admin:SUA_SENHA@db.host.supabase.co:5432/postgres"

# Limite por instância da API: 5 persistentes + até 5 temporárias.
# Ajuste considerando todas as instâncias e o limite do projeto Supabase.
DB_POOL_SIZE="5"
DB_MAX_OVERFLOW="5"
DB_POOL_TIMEOUT="15"
DB_POOL_RECYCLE="1800"

# ── SEGURANÇA / JWT ────────────────────────────────────────────
# Gere com: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="SUBSTITUA_POR_SUA_CHAVE_SECRET_KEY_ALEATORIA"

# Chave de criptografia para dados sensíveis (PII) no banco
# Gere com: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY="SUBSTITUA_POR_SUA_CHAVE_FERNET_ENCRYPTION_KEY"

# Login de clientes do cardápio por código enviado ao WhatsApp.
CUSTOMER_TOKEN_EXPIRE_MINUTES="43200"
CUSTOMER_OTP_TTL_SECONDS="300"
CUSTOMER_OTP_RESEND_SECONDS="60"
CUSTOMER_OTP_WINDOW_SECONDS="900"
CUSTOMER_OTP_MAX_SENDS="5"
CUSTOMER_OTP_MAX_ATTEMPTS="5"
CUSTOMER_OTP_MAX_IP_REQUESTS="20"

# ── SEED LOCAL DESTRUTIVO ─────────────────────────────────────
# O seed apaga e recria todas as tabelas. Use somente em banco descartável.
KOMA_ALLOW_DESTRUCTIVE_SEED=""
KOMA_SEED_ADMIN_PASSWORD=""

# ── SUPERADMIN ─────────────────────────────────────────────────
SUPERADMIN_USERNAME="admin"
# Hash bcrypt gerado via get_password_hash
SUPERADMIN_PASSWORD_HASH="SUBSTITUA_PELO_HASH_BCRYPT_DA_SUA_SENHA"

# ── SENTRY (MONITORAMENTO) ─────────────────────────────────────
SENTRY_DSN=""
SENTRY_SEND_PII="False"

# ── SERVIÇOS EXTERNOS (SUPERADMIN / DEVOPS) ────────────────────
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ZONE_ID=""
RAILWAY_API_TOKEN=""
RAILWAY_PROJECT_ID=""
RAILWAY_ENVIRONMENT_ID=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
GITHUB_TOKEN=""

# ── IMPRESSORA TÉRMICA ─────────────────────────────────────────
SIMULATE_PRINTER="True"
PRINTER_NAME="Generic / Text Only"
PRINTER_WIDTH="40"
PRINT_JOBS_DIR="./print_jobs"

# ── HOMOLOGAÇÃO DE PLANOS ─────────────────────────────────────
# IDs dos restaurantes autorizados a testar o Premium, separados por vírgula.
# Não altera o plano salvo no banco. O tenant 1 é a homologação atual;
# defina "" antes de cadastrar o primeiro cliente comercial.
KOMA_TEST_PREMIUM_RESTAURANTE_IDS="1"

# ── META CLOUD API (WHATSAPP OFICIAL) ─────────────────────────
META_VERIFY_TOKEN="1505"
# Encontrado em: Meta Developers > Kôma App > WhatsApp > Phone Number ID
META_PHONE_NUMBER_ID="1206090279260222"
META_ACCESS_TOKEN=""

# ── EVOLUTION API (WHATSAPP FALLBACK) ──────────────────────────
# Consulte infra/evolution/README.md. Em produção no mesmo projeto Railway,
# prefira a URL privada: http://evolution-api.railway.internal:8080
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE_NAME="koma-piloto"

# ── FRONTEND CONFIG ────────────────────────────────────────────
VITE_API_URL="http://localhost:8000"
VITE_WS_URL="ws://localhost:8000"
