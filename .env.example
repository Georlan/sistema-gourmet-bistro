# ─────────────────────────────────────────────────────────────
# KÔMA — Variáveis de Ambiente (Exemplo com Placeholders)
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA suba o .env para o git (já está no .gitignore).
# ─────────────────────────────────────────────────────────────

# ── BANCO DE DADOS ─────────────────────────────────────────────
# Desenvolvimento local: usa SQLite (sem configuração de senha)
DATABASE_URL="sqlite:///./bistro.db"

# Produção (Supabase/PostgreSQL RLS):
# DATABASE_URL="postgresql://usuario_app:SUA_SENHA@db.host.supabase.co:6543/postgres"
# MIGRATION_DATABASE_URL="postgresql://usuario_admin:SUA_SENHA@db.host.supabase.co:5432/postgres"

# Limite por instância da API: 5 persistentes + até 5 temporárias.
# Ajuste considerando todas as instâncias e o limite do projeto Supabase.
DB_POOL_SIZE="5"
DB_MAX_OVERFLOW="5"
DB_POOL_TIMEOUT="15"
DB_POOL_RECYCLE="1800"

# Limites de segurança do Alembic no pre-deploy do Railway.
# Evitam que uma migração espere indefinidamente por lock ou consulta travada.
MIGRATION_LOCK_TIMEOUT_MS="15000"
MIGRATION_STATEMENT_TIMEOUT_MS="600000"

# Em produção, Alembic é a única fonte do esquema. Não habilite este opt-in.
CREATE_SCHEMA_ON_STARTUP="false"

# ── SEGURANÇA / JWT ────────────────────────────────────────────
# Gere com: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="SUBSTITUA_POR_SUA_CHAVE_SECRET_KEY_ALEATORIA"

# Chave de criptografia para dados sensíveis (PII) no banco
# Gere com: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY="SUBSTITUA_POR_SUA_CHAVE_FERNET_ENCRYPTION_KEY"

# ── SEGURANÇA CORS (CONFIGURAÇÃO POR AMBIENTE) ────────────────
# Lista de origens autorizadas separadas por vírgula (scheme + host + porta).
# Em desenvolvimento: padrão http://localhost:5173,http://127.0.0.1:5173
# Em produção: especifique as origens oficiais exatas (ex: https://sistema-gourmet-bistro.pages.dev)
CORS_ALLOWED_ORIGINS="https://sistema-gourmet-bistro.pages.dev"

# Habilite somente se houver uso de cookies cross-origin (padrão false)
CORS_ALLOW_CREDENTIALS="false"

# Permite clientes WebSocket sem Origin (manter false em produção)
WEBSOCKET_ALLOW_MISSING_ORIGIN="false"

# Login de clientes do cardápio por código enviado ao WhatsApp.
CUSTOMER_TOKEN_EXPIRE_MINUTES="43200"
CUSTOMER_OTP_TTL_SECONDS="300"
CUSTOMER_OTP_RESEND_SECONDS="60"
CUSTOMER_OTP_WINDOW_SECONDS="900"
CUSTOMER_OTP_MAX_SENDS="5"
CUSTOMER_OTP_MAX_ATTEMPTS="5"
CUSTOMER_OTP_MAX_IP_REQUESTS="20"

# ── SEED LOCAL DESTRUTIVO ─────────────────────────────────────
# O seed apaga e recria todas as tabelas. Use somente em banco descartável.
KOMA_ALLOW_DESTRUCTIVE_SEED=""
KOMA_SEED_ADMIN_PASSWORD=""

# ── SUPERADMIN ─────────────────────────────────────────────────
SUPERADMIN_USERNAME="admin"
# Hash bcrypt gerado via get_password_hash
SUPERADMIN_PASSWORD_HASH="SUBSTITUA_PELO_HASH_BCRYPT_DA_SUA_SENHA"

# ── SENTRY (MONITORAMENTO) ─────────────────────────────────────
SENTRY_DSN=""
SENTRY_SEND_PII="False"

# ── SERVIÇOS EXTERNOS (SUPERADMIN / DEVOPS) ────────────────────
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ZONE_ID=""
RAILWAY_API_TOKEN=""
RAILWAY_PROJECT_ID=""
RAILWAY_ENVIRONMENT_ID=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
GITHUB_TOKEN=""

# ── IMPRESSORA TÉRMICA ─────────────────────────────────────────
# Fonte única de horário operacional para caixa, relatórios e impressão.
KOMA_TIMEZONE="America/Fortaleza"
SIMULATE_PRINTER="True"
PRINTER_NAME="Generic / Text Only"
PRINTER_WIDTH="40"
PRINT_JOBS_DIR="./print_jobs"

# ── SMARTPOS ───────────────────────────────────────────────────
# Mantenha "disabled" em produção até existir um adapter homologado.
# "pagbank_simulator" exercita o contrato F8–F12, mas NÃO realiza cobranças.
KOMA_SMARTPOS_PROVIDER="disabled"

# ── HOMOLOGAÇÃO DE PLANOS ─────────────────────────────────────
# IDs dos restaurantes autorizados a testar o Premium, separados por vírgula.
# Não altera o plano salvo no banco. O tenant 1 é a homologação atual;
# defina "" antes de cadastrar o primeiro cliente comercial.
KOMA_TEST_PREMIUM_RESTAURANTE_IDS="1"

# ── AUTOMAÇÃO WHATSAPP (DESATIVADA NO MVP - LINKS MANUAIS VIA WA.ME) ──────
# Por padrão (False), o backend opera sem automação de WhatsApp:
# - Rotas de webhook /api/whatsapp/* retornam 404
# - Nenhuma chamada externa à Meta Cloud API ou Evolution API é feita
# - Nenhuma variável META_* ou EVOLUTION_* é obrigatória no startup
KOMA_WHATSAPP_AUTOMATION_ENABLED="false"

# ── META CLOUD API (OPCIONAL / RESERVADO PARA USO FUTURO) ────
META_VERIFY_TOKEN=""
META_APP_SECRET=""
META_PHONE_NUMBER_ID=""
META_ACCESS_TOKEN=""
META_USE_TEMPLATE="False"
META_OTP_TEMPLATE_NAME="koma_otp"

# ── EVOLUTION API (OPCIONAL / RESERVADO PARA USO FUTURO) ─────
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE_NAME="koma-piloto"


# ── FRONTEND CONFIG ────────────────────────────────────────────
VITE_API_URL="http://localhost:8000"
VITE_WS_URL="ws://localhost:8000"

# Monitoramento de erros no navegador. Opcional; sem DSN o SDK não é inicializado.
VITE_SENTRY_DSN=""

# Cardápio Digital — Supabase (chaves públicas, seguras para o frontend)
# Obtenha em: Supabase Dashboard → Project Settings → API → Project URL / Publishable key
VITE_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_SUA_CHAVE_PUBLICA"
# Nota: VITE_SUPABASE_PUBLISHABLE_KEY substitui a variável anterior VITE_SUPABASE_ANON_KEY.
#       Chaves anon/publishable são PÚBLICAS por design e seguras para o frontend.
#       NUNCA coloque SUPABASE_SERVICE_ROLE_KEY ou sb_secret_... em variáveis VITE_.
